{
	"routes": [
		{
			"route": "/api/isotopes",
			"methods": ["POST"],
			"allowedRoles": ["isotope_writer"]
		},
		{
			"route": "/api/reference-materials",
			"methods": ["POST"],
			"allowedRoles": ["isotope_writer"]
		},
		{
			"route": "/api/isotope-measurements",
			"methods": ["GET", "POST"],
			"allowedRoles": ["isotope_writer"]
		}
	],
	"responseOverrides": {
		"401": {
			"redirect": "/.auth/login/aad",
			"statusCode": 302
		},
		"403": {
			"rewrite": "/index.html",
			"statusCode": 403
		}
	},
	"navigationFallback": {
		"rewrite": "/index.html",
		"exclude": ["/api/*", "/app/*", "/favicon.svg"]
	}
}